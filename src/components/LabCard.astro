---
interface Props {
  number: number;
  title: string;
  description: string;
  href: string;
}
const { number, title, description, href } = Astro.props;
const formatted = String(number).padStart(2, '0');
---
<a class="content-card lab-card" href={href}>
  <div class="card-topline">
    <span class="card-number lab-number">P{formatted}</span>
    <span class="card-tag">Laboratorio</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="card-link">Consultar práctica <span aria-hidden="true">↗</span></span>
</a>
