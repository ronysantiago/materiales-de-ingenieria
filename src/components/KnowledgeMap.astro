---
interface GraphNode {
  id: string;
  label: string;
  fullTitle: string;
  type: 'tema' | 'laboratorio';
  href: string;
  x: number;
  y: number;
}
interface GraphEdge { from: string; to: string; }
const { nodes, edges } = Astro.props as { nodes: GraphNode[]; edges: GraphEdge[] };
const nodeMap = new Map<string, GraphNode>(nodes.map((node) => [node.id, node] as const));
---
<div class="graph-tools">
  <label class="graph-search-label" for="graph-search">Buscar en la red</label>
  <input id="graph-search" class="field graph-search" type="search" placeholder="Ej. aceros, corrosión, aluminio..." autocomplete="off" />
  <div class="graph-filters" role="group" aria-label="Filtrar elementos del mapa">
    <button class="filter-chip is-selected" type="button" data-filter="todos" aria-pressed="true">Todos</button>
    <button class="filter-chip" type="button" data-filter="tema" aria-pressed="false">Temas</button>
    <button class="filter-chip" type="button" data-filter="laboratorio" aria-pressed="false">Laboratorios</button>
    <span class="graph-hint">Selecciona un nodo para abrir su contenido.</span>
  </div>
</div>
<div class="graph-scroll" tabindex="0" aria-label="Mapa de conexiones desplazable">
  <svg class="knowledge-graph" viewBox="0 0 1460 910" role="img" aria-labelledby="graph-title graph-desc">
    <title id="graph-title">Mapa de conexiones de Materiales de Ingeniería</title>
    <desc id="graph-desc">Relaciones entre los diez temas y las siete prácticas del programa oficial.</desc>
    <g class="graph-edges">
      {edges.map((edge) => {
        const a = nodeMap.get(edge.from);
        const b = nodeMap.get(edge.to);
        return a && b ? <line class="graph-edge" data-from={edge.from} data-to={edge.to} x1={a.x} y1={a.y} x2={b.x} y2={b.y} /> : null;
      })}
    </g>
    <g class="graph-nodes">
      {nodes.map((node) => (
        <a class:list={['graph-node', node.type === 'laboratorio' ? 'graph-lab' : 'graph-topic']} data-node={node.id} data-type={node.type} data-search={node.fullTitle.toLocaleLowerCase('es')} href={node.href} aria-label={`Abrir ${node.fullTitle}`}>
          <title>{node.fullTitle}</title>
          <rect x={node.x - 91} y={node.y - 39} width="182" height="78" rx="15" />
          <text class="graph-node-kicker" x={node.x} y={node.y - 8}>{node.type === 'tema' ? `TEMA ${node.id.slice(1)}` : `PRÁCTICA ${node.id.slice(1)}`}</text>
          <text class="graph-node-label" x={node.x} y={node.y + 15}>{node.label}</text>
        </a>
      ))}
    </g>
  </svg>
</div>
<p class="graph-status" id="graph-status" aria-live="polite">Se muestran todos los temas y laboratorios del programa.</p>
<script>
  const search = document.querySelector<HTMLInputElement>('#graph-search');
  const nodes = [...document.querySelectorAll<SVGAElement>('[data-node]')];
  const edges = [...document.querySelectorAll<SVGLineElement>('.graph-edge')];
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const status = document.querySelector<HTMLElement>('#graph-status');
  let selectedType = 'todos';

  function updateGraph() {
    const query = (search?.value || '').trim().toLocaleLowerCase('es');
    const visible = new Set<string>();
    for (const node of nodes) {
      const id = node.dataset.node || '';
      const type = node.dataset.type || '';
      const title = node.dataset.search || '';
      const match = (!query || title.includes(query)) && (selectedType === 'todos' || selectedType === type);
      node.classList.toggle('is-hidden', !match);
      node.classList.toggle('is-dimmed', Boolean(query) && match && !title.startsWith(query));
      if (match) visible.add(id);
    }
    for (const edge of edges) {
      const from = edge.dataset.from || '';
      const to = edge.dataset.to || '';
      edge.classList.toggle('is-hidden', !visible.has(from) || !visible.has(to));
    }
    if (status) status.textContent = `${visible.size} elementos visibles en el mapa.`;
  }

  search?.addEventListener('input', updateGraph);
  filters.forEach((button) => button.addEventListener('click', () => {
    selectedType = button.dataset.filter || 'todos';
    filters.forEach((item) => {
      const active = item === button;
      item.classList.toggle('is-selected', active);
      item.setAttribute('aria-pressed', String(active));
    });
    updateGraph();
  }));
</script>
