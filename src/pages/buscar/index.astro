---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
const temas = (await getCollection('temas')).sort((a, b) => a.data.number - b.data.number);
const labs = (await getCollection('laboratorios')).sort((a, b) => a.data.number - b.data.number);
const results = [
  ...temas.map((entry) => ({ kind: 'Tema', number: `T${String(entry.data.number).padStart(2,'0')}`, title: entry.data.title, description: entry.data.description, href: `/temas/${entry.id}/`, search: `${entry.data.title} ${entry.data.description} ${entry.data.keywords.join(' ')}` })),
  ...labs.map((entry) => ({ kind: 'Laboratorio', number: `P${String(entry.data.number).padStart(2,'0')}`, title: entry.data.title, description: entry.data.description, href: `/laboratorios/${entry.id}/`, search: `${entry.data.title} ${entry.data.description} ${entry.data.keywords.join(' ')}` })),
];
---
<BaseLayout title="Buscar contenidos" description="Buscador de temas y prácticas de Materiales de Ingeniería." active="buscar">
  <section class="page-hero"><div class="page-hero-inner">
    <div class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Buscar</span></div>
    <span class="eyebrow">Consulta rápida</span>
    <h1>Buscar en el portal</h1>
    <p>Localiza temas teóricos y prácticas utilizando títulos, descripciones o palabras clave.</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="search-panel">
      <label class="graph-search-label" for="site-search">¿Qué contenido necesitas encontrar?</label>
      <input class="field" id="site-search" type="search" placeholder="Ej. diagrama TTT, aluminio, corrosión..." autocomplete="off" />
      <div class="search-results" id="search-results">
        {results.map((result) => <a class="search-result" href={result.href} data-search-item data-search={result.search.toLocaleLowerCase('es')}>
          <span class="search-result-kind">{result.number} · {result.kind}</span>
          <span><h3>{result.title}</h3><p>{result.description}</p></span>
          <span class="program-arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
      <p class="empty-state" id="empty-state">No se encontraron resultados. Prueba con otra palabra.</p>
      <p class="graph-status" id="search-count">Mostrando {results.length} elementos.</p>
    </div>
  </div></section>
  <script>
    const input = document.querySelector<HTMLInputElement>('#site-search');
    const items = [...document.querySelectorAll<HTMLElement>('[data-search-item]')];
    const empty = document.querySelector<HTMLElement>('#empty-state');
    const count = document.querySelector<HTMLElement>('#search-count');
    input?.addEventListener('input', () => {
      const query = (input.value || '').trim().toLocaleLowerCase('es');
      let visible = 0;
      for (const item of items) {
        const match = !query || (item.dataset.search || '').includes(query);
        item.hidden = !match;
        if (match) visible++;
      }
      if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
      if (count) count.textContent = `Se muestran ${visible} de ${items.length} elementos.`;
    });
  </script>
</BaseLayout>
