---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import KnowledgeMap from '@components/KnowledgeMap.astro';

const themes = (await getCollection('temas')).sort((a, b) => a.data.number - b.data.number);
const labs = (await getCollection('laboratorios')).sort((a, b) => a.data.number - b.data.number);
const topicPositions = [
  { x: 730, y: 85 },
  { x: 350, y: 260 },
  { x: 730, y: 260 },
  { x: 1110, y: 260 },
  { x: 180, y: 465 },
  { x: 535, y: 465 },
  { x: 890, y: 465 },
  { x: 1245, y: 465 },
  { x: 465, y: 650 },
  { x: 995, y: 650 },
];
const labPositions = [
  { x: 130, y: 820 }, { x: 330, y: 820 }, { x: 530, y: 820 },
  { x: 730, y: 820 }, { x: 930, y: 820 }, { x: 1130, y: 820 }, { x: 1330, y: 820 },
];
const topicLabels = ['Generalidades', 'Transformaciones', 'Materiales ferrosos', 'No ferrosos', 'Cerámicos', 'Poliméricos', 'Compuestos', 'Semiconductores', 'Corrosión', 'Selección'];
const labLabels = ['Puntos críticos', 'Recocido y normalizado', 'Temple y revenido', 'Acero inoxidable', 'Aluminio', 'Cerámicos', 'Polímeros y compuestos'];
const nodes = [
  ...themes.map((entry, index) => ({ id: `t${entry.data.number}`, label: topicLabels[index] ?? entry.data.title, fullTitle: `Tema ${entry.data.number}: ${entry.data.title}`, type: 'tema' as const, href: `/temas/${entry.id}/`, ...topicPositions[index] })),
  ...labs.map((entry, index) => ({ id: `p${entry.data.number}`, label: labLabels[index] ?? entry.data.title, fullTitle: `Práctica ${entry.data.number}: ${entry.data.title}`, type: 'laboratorio' as const, href: `/laboratorios/${entry.id}/`, ...labPositions[index] })),
];
const topicKeyBySlug = new Map(themes.map((entry) => [entry.id, `t${entry.data.number}`]));
const labKeyBySlug = new Map(labs.map((entry) => [entry.id, `p${entry.data.number}`]));
const edgeKeys = new Set<string>();
const edges: { from: string; to: string }[] = [];
function addEdge(from: string | undefined, to: string | undefined) {
  if (!from || !to || from === to) return;
  const key = [from, to].sort().join('|');
  if (edgeKeys.has(key)) return;
  edgeKeys.add(key);
  edges.push({ from, to });
}
for (const theme of themes) {
  for (const related of theme.data.relatedTopics) addEdge(`t${theme.data.number}`, topicKeyBySlug.get(related));
  for (const related of theme.data.relatedLabs) addEdge(`t${theme.data.number}`, labKeyBySlug.get(related));
}
for (const lab of labs) {
  for (const related of lab.data.relatedTopics) addEdge(`p${lab.data.number}`, topicKeyBySlug.get(related));
}
---
<BaseLayout title="Mapa de conexiones" description="Red navegable de relaciones entre los diez temas y las siete prácticas de Materiales de Ingeniería." active="mapa">
  <section class="page-hero"><div class="page-hero-inner">
    <div class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Mapa de conexiones</span></div>
    <span class="eyebrow">Red de conocimientos</span>
    <h1>Mapa de conexiones</h1>
    <p>Relaciones entre los diez temas teóricos y las siete prácticas. La red se genera a partir de los vínculos definidos en los documentos de contenido.</p>
  </div></section>
  <section class="section"><div class="container">
    <div class="section-heading"><span class="eyebrow">Exploración interactiva</span><h2>Relaciones del programa académico</h2><p>Busca un material, filtra por tipo de unidad y selecciona un nodo para navegar hacia su ficha.</p></div>
    <KnowledgeMap nodes={nodes} edges={edges} />
    <div class="graph-legend"><span class="legend-item"><i class="legend-dot"></i> Tema teórico</span><span class="legend-item"><i class="legend-dot lab"></i> Práctica de laboratorio</span><span class="legend-item">Las líneas representan relaciones temáticas o experimentales.</span></div>
  </div></section>
</BaseLayout>
