---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import LabCard from '@components/LabCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
const laboratorios = (await getCollection('laboratorios')).sort((a, b) => a.data.number - b.data.number);
---
<BaseLayout title="Laboratorios" description="Las siete prácticas de laboratorio de Materiales de Ingeniería." active="laboratorios">
  <section class="page-hero"><div class="page-hero-inner">
    <div class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Laboratorios</span></div>
    <span class="eyebrow">Contenido experimental</span>
    <h1>Prácticas de laboratorio</h1>
    <p>Siete prácticas relacionadas con los contenidos teóricos. Cada ficha organiza el alcance oficial y reserva espacios para incorporar la guía experimental y los resultados de trabajo.</p>
  </div></section>
  <section class="section"><div class="container">
    <SectionHeading eyebrow="Programa de laboratorio" title="Prácticas de la asignatura" text="Los procedimientos y parámetros experimentales se completarán con las guías y las indicaciones del docente." />
    <div class="card-grid">
      {laboratorios.map((lab) => <LabCard number={lab.data.number} title={lab.data.title} description={lab.data.description} href={`/laboratorios/${lab.id}/`} />)}
    </div>
  </div></section>
</BaseLayout>
