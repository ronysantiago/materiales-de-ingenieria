---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const labs = await getCollection('laboratorios');
  return labs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allTemas = await getCollection('temas');
const relatedTopics = entry.data.relatedTopics.map((id) => allTemas.find((item) => item.id === id)).filter(Boolean);
---
<BaseLayout title={entry.data.title} description={entry.data.description} active="laboratorios">
  <section class="page-hero"><div class="page-hero-inner">
    <div class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/laboratorios/">Laboratorios</a><span aria-hidden="true">/</span><span>Práctica {String(entry.data.number).padStart(2,'0')}</span></div>
    <span class="eyebrow">Práctica {String(entry.data.number).padStart(2,'0')} · Laboratorio</span>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </div></section>
  <div class="container detail-layout">
    <article class="detail-content">
      <div class="prose"><Content /></div>
      <div class="empty-content"><h3>Ficha experimental</h3><p>Esta ficha se completará con la guía de laboratorio, los datos obtenidos, los cálculos y las observaciones correspondientes. No se han supuesto procedimientos ni parámetros que no estén en el programa proporcionado.</p></div>
      <span class="content-status">Alcance basado en el programa suministrado</span>
    </article>
    <aside class="detail-sidebar" aria-label="Información relacionada">
      <section class="sidebar-card"><h3>Datos de la asignatura</h3><p><strong>Materiales de Ingeniería</strong><br />Docente: Ing. Ramón Tolosa</p></section>
      <section class="sidebar-card"><h3>Temas relacionados</h3><div class="related-list">{relatedTopics.map((topic) => <a class="related-link" href={`/temas/${topic!.id}/`}>T{String(topic!.data.number).padStart(2,'0')} · {topic!.data.title}</a>)}</div></section>
      <section class="sidebar-card"><h3>Explorar</h3><div class="related-list"><a class="related-link" href="/laboratorios/">Todas las prácticas</a><a class="related-link" href="/mapa/">Mapa de conexiones</a><a class="related-link" href="/programa/">Programa completo</a></div></section>
    </aside>
  </div>
</BaseLayout>
