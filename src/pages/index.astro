---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import TopicCard from '@components/TopicCard.astro';
import LabCard from '@components/LabCard.astro';
import SectionHeading from '@components/SectionHeading.astro';

const temas = (await getCollection('temas')).sort((a, b) => a.data.number - b.data.number);
const laboratorios = (await getCollection('laboratorios')).sort((a, b) => a.data.number - b.data.number);
const featuredTopics = temas.slice(0, 3);
const featuredLabs = laboratorios.slice(0, 2);
---
<BaseLayout title="Materiales de Ingeniería" description="Portal académico de Materiales de Ingeniería. Programa teórico, laboratorios y red de conexiones." active="inicio">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Portal académico · Ingeniería</span>
        <h1>Comprender los materiales. <span>Diseñar mejor.</span></h1>
        <p class="hero-lead">Un espacio organizado para estudiar las familias de materiales, sus propiedades, transformaciones, procesamiento y aplicaciones en ingeniería.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/temas/">Explorar contenidos <span aria-hidden="true">↗</span></a>
          <a class="button button-ghost" href="/programa/">Consultar programa</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="material-orbit">
          <span class="orbit-chip one">PROPIEDADES</span>
          <span class="orbit-chip two">PROCESAMIENTO</span>
          <span class="orbit-chip three">MATERIALES</span>
          <span class="orbit-chip four">APLICACIONES</span>
          <div class="orbit-core">M · I</div>
        </div>
        <span class="hero-note">Estructura · Comportamiento · Selección</span>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="stats-grid" aria-label="Resumen del programa">
      <div class="stat-card"><span class="stat-value">10</span><span class="stat-label">Temas teóricos oficiales</span></div>
      <div class="stat-card"><span class="stat-value">07</span><span class="stat-label">Prácticas de laboratorio</span></div>
      <div class="stat-card"><span class="stat-value">17</span><span class="stat-label">Unidades de navegación</span></div>
      <div class="stat-card"><span class="stat-value">01</span><span class="stat-label">Programa académico de referencia</span></div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-topline">
        <SectionHeading eyebrow="Contenido teórico" title="Explora los temas de la asignatura" text="Diez unidades organizadas según el contenido programático de Materiales de Ingeniería." />
        <a class="text-link" href="/temas/">Ver los diez temas <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid">
        {featuredTopics.map((topic) => <TopicCard number={topic.data.number} title={topic.data.title} description={topic.data.description} href={`/temas/${topic.id}/`} />)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-topline">
        <SectionHeading eyebrow="Trabajo experimental" title="Prácticas de laboratorio" text="El programa incluye siete prácticas vinculadas con los temas de la asignatura." />
        <a class="text-link" href="/laboratorios/">Ver las siete prácticas <span aria-hidden="true">→</span></a>
      </div>
      <div class="card-grid two">
        {featuredLabs.map((lab) => <LabCard number={lab.data.number} title={lab.data.title} description={lab.data.description} href={`/laboratorios/${lab.id}/`} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="info-band">
        <div>
          <span class="eyebrow">Conocimiento conectado</span>
          <h2>Los contenidos no se estudian de forma aislada.</h2>
          <p>El mapa relaciona temas, tratamientos y prácticas para mostrar cómo se articulan los contenidos del programa.</p>
          <div class="hero-actions"><a class="button button-primary" href="/mapa/">Abrir mapa de conexiones <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="info-points">
          <div class="info-point">Relaciones entre temas teóricos</div>
          <div class="info-point">Vínculos entre teoría y laboratorio</div>
          <div class="info-point">Navegación directa hacia cada contenido</div>
          <div class="info-point">Estructura preparada para integrar Obsidian</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-compact section-soft">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Identificación académica</span>
        <h2>Materiales de Ingeniería</h2>
        <p><strong>Docente:</strong> Ing. Ramón Tolosa. El portal organiza el contenido programático teórico y de laboratorio suministrado para la asignatura.</p>
      </div>
      <a class="text-link" href="/programa/">Consultar el alcance completo del programa <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
