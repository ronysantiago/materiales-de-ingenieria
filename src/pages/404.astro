---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página solicitada no existe en el portal de Materiales de Ingeniería.">
  <section class="page-hero"><div class="page-hero-inner">
    <span class="eyebrow">Error 404</span>
    <h1>No encontramos esta página.</h1>
    <p>Puede que el contenido se haya movido o que la dirección no sea correcta.</p>
    <div class="hero-actions"><a class="button button-primary" href="/">Volver al inicio</a><a class="button button-ghost" href="/temas/">Explorar temas</a></div>
  </div></section>
</BaseLayout>
