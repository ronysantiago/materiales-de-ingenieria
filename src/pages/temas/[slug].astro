---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const temas = await getCollection('temas');
  return temas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allTemas = await getCollection('temas');
const allLabs = await getCollection('laboratorios');
const relatedTopics = entry.data.relatedTopics.map((id) => allTemas.find((item) => item.id === id)).filter(Boolean);
const relatedLabs = entry.data.relatedLabs.map((id) => allLabs.find((item) => item.id === id)).filter(Boolean);
---
<BaseLayout title={entry.data.title} description={entry.data.description} active="temas">
  <section class="page-hero"><div class="page-hero-inner">
    <div class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/temas/">Temas</a><span aria-hidden="true">/</span><span>Tema {String(entry.data.number).padStart(2,'0')}</span></div>
    <span class="eyebrow">Tema {String(entry.data.number).padStart(2,'0')} · Contenido teórico</span>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </div></section>
  <div class="container detail-layout">
    <article class="detail-content">
      <div class="prose"><Content /></div>
      <span class="content-status">Contenido basado en el programa suministrado</span>
    </article>
    <aside class="detail-sidebar" aria-label="Información relacionada">
      <section class="sidebar-card"><h3>Datos de la asignatura</h3><p><strong>Materiales de Ingeniería</strong><br />Docente: Ing. Ramón Tolosa</p></section>
      {relatedLabs.length > 0 && <section class="sidebar-card"><h3>Prácticas relacionadas</h3><div class="related-list">{relatedLabs.map((lab) => <a class="related-link" href={`/laboratorios/${lab!.id}/`}>P{String(lab!.data.number).padStart(2,'0')} · {lab!.data.title}</a>)}</div></section>}
      {relatedTopics.length > 0 && <section class="sidebar-card"><h3>Temas conectados</h3><div class="related-list">{relatedTopics.map((topic) => <a class="related-link" href={`/temas/${topic!.id}/`}>T{String(topic!.data.number).padStart(2,'0')} · {topic!.data.title}</a>)}</div></section>}
      <section class="sidebar-card"><h3>Explorar</h3><div class="related-list"><a class="related-link" href="/mapa/">Mapa de conexiones</a><a class="related-link" href="/programa/">Programa completo</a><a class="related-link" href="/buscar/">Buscar en el portal</a></div></section>
    </aside>
  </div>
</BaseLayout>
