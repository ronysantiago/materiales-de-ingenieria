---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import TopicCard from '@components/TopicCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
const temas = (await getCollection('temas')).sort((a, b) => a.data.number - b.data.number);
---
<BaseLayout title="Temas teóricos" description="Los diez temas del programa de Materiales de Ingeniería." active="temas">
  <section class="page-hero"><div class="page-hero-inner">
    <div class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Temas</span></div>
    <span class="eyebrow">Contenido teórico</span>
    <h1>Temas de la asignatura</h1>
    <p>Diez unidades organizadas para consultar su alcance, revisar sus contenidos y navegar por sus relaciones con otras partes del programa.</p>
  </div></section>
  <section class="section"><div class="container">
    <SectionHeading eyebrow="Programa oficial" title="Contenido teórico completo" text="Selecciona una unidad para consultar su contenido programático y sus conexiones." />
    <div class="card-grid">
      {temas.map((tema) => <TopicCard number={tema.data.number} title={tema.data.title} description={tema.data.description} href={`/temas/${tema.id}/`} />)}
    </div>
  </div></section>
</BaseLayout>
